:root{--carta:#eef0f3;--inchiostro:#14213d;--giallo:#ffc928;--grigio:#4a5568;--bianco:#fff}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;background:var(--carta);color:var(--inchiostro);font-family:"Source Serif 4",Georgia,serif;font-size:1.125rem;line-height:1.65}
h1,h2{font-family:"Archivo Black","Arial Black",Impact,sans-serif;font-weight:400;line-height:1.1;margin:0 0 .6em}
h1{font-size:clamp(2rem,7vw,3rem)}
a{color:var(--inchiostro)}a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid var(--giallo);outline-offset:3px}
.wrap{max-width:760px;margin:0 auto;padding:0 1.25rem}
main .wrap{padding-top:3rem;padding-bottom:4rem}
header.top{background:var(--inchiostro)}
header.top .wrap{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.5rem 1.5rem;padding-top:1rem;padding-bottom:1rem}
.logo{font-family:"Archivo Black","Arial Black",sans-serif;color:var(--bianco);text-decoration:none}
nav a{color:var(--bianco);text-decoration:none;margin-right:1rem;font-size:1rem}nav a:last-child{margin-right:0}
nav a:hover,nav a[aria-current]{color:var(--giallo)}
.nastro{height:22px;background:repeating-linear-gradient(-45deg,var(--giallo) 0 22px,var(--inchiostro) 22px 44px)}
.hero{padding:2rem 0}.hero h1{font-size:clamp(2.6rem,10vw,5rem)}.hero p{font-size:1.3rem;max-width:34ch}
.btn{display:inline-block;background:var(--giallo);color:var(--inchiostro);font-family:"Archivo Black","Arial Black",sans-serif;font-size:1rem;text-decoration:none;padding:.85rem 1.4rem;border:3px solid var(--inchiostro);cursor:pointer;margin:0 .5rem .5rem 0}
.btn:hover{background:var(--inchiostro);color:var(--giallo)}.alt-btn{background:var(--bianco)}
ul.eventi{list-style:none;margin:1.5rem 0;padding:0}
ul.eventi>li{padding:1rem 0;border-top:2px solid var(--inchiostro)}ul.eventi>li:last-child{border-bottom:2px solid var(--inchiostro)}
ul.eventi strong{display:block;font-family:"Archivo Black","Arial Black",sans-serif;font-weight:400}
ul.eventi a{text-decoration:none;display:block}ul.eventi a:hover strong{text-decoration:underline}
.capo{display:flex;flex-wrap:wrap;align-items:center;gap:.75rem 1.5rem}.capo>div{flex:1 1 200px}
label{font-size:1rem}.campo{display:block;margin:1rem 0}
input,select,textarea{font:inherit;padding:.5rem;border:2px solid var(--inchiostro);background:var(--bianco);color:var(--inchiostro)}
.campo input,.campo textarea{display:block;width:100%;margin-top:.3rem}
input[type=number]{width:5rem}
footer{background:var(--inchiostro);color:var(--bianco);padding:2rem 0;font-size:1rem}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
